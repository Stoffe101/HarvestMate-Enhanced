# BigWigs packager settings (optional; tools/package.py builds the same ZIP).
# The addon lives in HarvestMateEnhanced/; everything else is development.
package-as: HarvestMateEnhanced

move-folders:
  HarvestMateEnhanced/HarvestMateEnhanced: HarvestMateEnhanced

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - .github
  - tests
  - tools
  - upstream
  - docs
  - art
  - dist
